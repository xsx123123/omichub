# ============================================
# CygnusX 前端 Dockerfile
# 多阶段构建：node 构建 + nginx 托管
# ============================================

# ----- 阶段 1: 构建前端 -----
FROM node:20-alpine AS builder

ARG NPM_REGISTRY=https://registry.npmmirror.com

# Keep the original display dependencies in their own locked workspace.
# Domestic registry first, official registry fallback (IMSA).
RUN npm install --global pnpm@9.15.9 --registry="${NPM_REGISTRY}" \
    || npm install --global pnpm@9.15.9 --registry=https://registry.npmjs.org
WORKDIR /app/pipelines/Treasure-Seeking_Mouse
COPY pipelines/Treasure-Seeking_Mouse/package.json pipelines/Treasure-Seeking_Mouse/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile --registry="${NPM_REGISTRY}" \
    || pnpm install --frozen-lockfile --registry=https://registry.npmjs.org
COPY pipelines/Treasure-Seeking_Mouse/src ./src
COPY pipelines/Treasure-Seeking_Mouse/shared ./shared
COPY pipelines/Treasure-Seeking_Mouse/archive/island ./archive/island
COPY pipelines/Treasure-Seeking_Mouse/tsconfig.json ./

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci --registry="${NPM_REGISTRY}" \
    || npm ci --registry=https://registry.npmjs.org

COPY frontend/ ./
RUN npm run build

# ----- 阶段 2: Nginx 托管 -----
FROM nginx:alpine AS runtime

# 复制构建产物
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

# 复制 Nginx 配置
COPY deploy/docker/nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
